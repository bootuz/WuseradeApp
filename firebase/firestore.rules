rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // True when the caller is signed in (anonymous accounts included) as `uid`.
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // users/{uid}: createdAt:timestamp, optional displayName:string, nothing else.
    function validUser() {
      let d = request.resource.data;
      return d.keys().hasOnly(['createdAt', 'displayName'])
        && d.keys().hasAll(['createdAt'])
        && d.createdAt is timestamp
        && (!('displayName' in d) || d.displayName is string);
    }

    // users/{uid}/likes/{likeId}: exactly these fields, and poemId == int(likeId).
    function validLike(likeId) {
      let d = request.resource.data;
      return d.keys().hasOnly(['poemId', 'likedAt', 'title', 'authorId', 'authorName', 'text'])
        && d.keys().hasAll(['poemId', 'likedAt', 'title', 'authorId', 'authorName', 'text'])
        && d.poemId is int
        && d.poemId == int(likeId)
        && d.likedAt is timestamp
        && d.title is string
        && d.authorId is int
        && d.authorName is string
        && d.text is string;
    }

    // users/{uid}/reads/{poemId}: exactly poemId:int and readAt:timestamp, poemId == int(readId),
    // readAt is the server time. Created once; never updated.
    function validRead(readId) {
      let d = request.resource.data;
      return d.keys().hasOnly(['poemId', 'readAt'])
        && d.keys().hasAll(['poemId', 'readAt'])
        && d.poemId is int
        && d.poemId == int(readId)
        && d.readAt == request.time;
    }

    // users/{uid}/devices/{installId}: exactly these six fields. notifyAt is "HH:MM" on a 24-hour
    // clock (rules regexes match the whole string), updatedAt is the server time.
    function validDevice(installId) {
      let d = request.resource.data;
      return d.keys().hasOnly(['fcmToken', 'timeZone', 'notifyAt', 'enabled', 'nextSendAt', 'updatedAt'])
        && d.keys().hasAll(['fcmToken', 'timeZone', 'notifyAt', 'enabled', 'nextSendAt', 'updatedAt'])
        && d.fcmToken is string
        && d.fcmToken.size() <= 4096
        && d.timeZone is string
        && d.timeZone.size() <= 64
        && d.notifyAt is string
        && d.notifyAt.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && d.enabled is bool
        && d.nextSendAt is timestamp
        && d.updatedAt == request.time
        && installId.size() <= 64;
    }

    // True when the caller may send a photo: signed in with Apple or Google (so not anonymous),
    // or an account that has linked one of them, and not banned. A token minted right after
    // linking can still say `anonymous` as its sign-in provider; its `identities` already name the
    // linked provider. `photoBan` is a custom claim the owner sets; most tokens lack it, and a
    // token may lack `identities`, so both are read with `.get`, because reading a missing key is
    // an error and an error means "deny".
    // storage.rules has the same function: keep the two in step.
    function canSendPhotos() {
      return request.auth != null
        && (request.auth.token.firebase.get('sign_in_provider', '') in ['apple.com', 'google.com']
          || 'apple.com' in request.auth.token.firebase.get('identities', {})
          || 'google.com' in request.auth.token.firebase.get('identities', {}))
        && request.auth.token.get('photoBan', false) != true;
    }

    // photoSubmissions/{authorId}_{uid}: exactly authorId:int, submittedBy:string and
    // createdAt:timestamp. authorId is 1 to 999999 (storage.rules takes the same range),
    // submittedBy is the caller, createdAt is the server time, and the document ID is
    // authorId_uid, so a caller can only ever write their own record.
    function validSubmission(id) {
      let d = request.resource.data;
      return d.keys().hasOnly(['authorId', 'submittedBy', 'createdAt'])
        && d.keys().hasAll(['authorId', 'submittedBy', 'createdAt'])
        && d.authorId is int
        && d.authorId > 0
        && d.authorId < 1000000
        && d.submittedBy == request.auth.uid
        && d.createdAt == request.time
        && id == string(d.authorId) + '_' + request.auth.uid;
    }

    // True when the document ID is `{authorId}_{uid}` with the caller's uid. It looks at the ID
    // only, never at resource.data, so get and delete work on a record that doesn't exist yet.
    function ownsSubmission(id) {
      return request.auth != null
        && id.split('_').size() == 2
        && id.split('_')[1] == request.auth.uid;
    }

    // Content: anyone can get a document by its ID, which is all the app does. Listing or querying
    // a collection is denied: one query on poems would bill ~4,000 reads. Written only through the
    // Admin SDK (which bypasses rules).
    match /poems/{poemId} {
      allow get: if true;
    }
    match /authors/{authorId} {
      allow get: if true;
    }
    match /themes/{themeId} {
      allow get: if true;
    }
    match /catalog/{chunkId} {
      allow get: if true;
    }
    match /meta/{docId} {
      allow get: if true;
    }
    // The poem of the day, written only through the Admin SDK. Get by date; never listed.
    match /daily/{date} {
      allow get: if true;
    }

    // Per-user data: only the signed-in owner, with validated shapes.
    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && validUser();

      match /likes/{likeId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validLike(likeId);
      }

      // Poems the user has opened: created once, listed only by the account merge, never updated.
      match /reads/{readId} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid) && validRead(readId);
      }

      // One document per app install, for the morning push. The server reads these through a
      // collection-group query with the Admin SDK, which bypasses rules.
      match /devices/{installId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validDevice(installId);
      }
    }

    // A reader's photo of a poet, waiting for the owner's approval (the photo itself is in
    // Storage). A reader can send, resend, check and withdraw their own record. Listing is
    // never allowed; the owner reads these through the Admin SDK, which bypasses rules.
    match /photoSubmissions/{id} {
      allow create, update: if canSendPhotos() && validSubmission(id);
      allow get, delete: if ownsSubmission(id);
    }

    // Everything else is denied (no catch-all allow).
  }
}
