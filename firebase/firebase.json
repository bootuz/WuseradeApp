{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "python312",
      "ignore": [
        "venv",
        ".venv",
        ".git",
        "*.local",
        "__pycache__",
        ".pytest_cache",
        "*.egg-info",
        "tests"
      ]
    }
  ],
  "hosting": {
    "public": "hosting",
    "cleanUrls": true
  },
  "emulators": {
    "firestore": {
      "port": 8080
    },
    "storage": {
      "port": 9199
    },
    "auth": {
      "port": 9099
    },
    "hosting": {
      "port": 5050
    },
    "ui": {
      "enabled": false
    }
  }
}
